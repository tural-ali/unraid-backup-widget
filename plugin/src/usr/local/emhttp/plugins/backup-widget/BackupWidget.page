Menu="Dashboard:0"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.11.9','>')"
---
<?PHP
/* Backup status tile for the Unraid dashboard.
 *
 * Rendering lives in overview-widget.php, which shares bo_state() with the full
 * Tools > Backup Overview page, so the tile and the page cannot disagree.
 *
 * REGISTRATION CONTRACT - this is not free-form. Unraid 7.x expects
 *   $mytiles[$plugin]['columnN'] = "<tbody>...<tr><td>...</td></tr></tbody>"
 * with columnN being column1, column2 or column3 (this tile uses column2).
 * and the tile must BE a tbody, because it is spliced into the dashboard's own
 * table. Returning an array of name/title/body instead registers nothing and the
 * tile silently does not appear - which is exactly what happened on 2026-08-03.
 *
 * IMPORTANT: every .page file is included into the SAME variable scope as
 * Unraid's own dashboard code (DashStats.page reads `global $mytiles`).
 * Declaring ordinary names like $i, $c, $d or $row at top level clobbers
 * Unraid's variables and blanks the whole dashboard - that happened on
 * 2026-07-28. So the only globals touched here are $mytiles and
 * $backup_widget_plugin, and all logic sits behind functions.
 *
 * The inline script and style contain no "<", "&" or ">" characters, so the
 * emitted fragment stays well-formed markup - the deploy check parses it as XML.
 * That rules out "&&" (use nested ifs) and CSS child selectors like "a > b"
 * (give the element a class instead).
 *
 * Live updates: a 1s tick patches the transfer figures from rclone's rc server,
 * a 30s tick rebuilds the body for the slower coverage data. The tile is only in
 * the DOM while the dashboard is open, so both are cheap.
 */
require_once '/usr/local/emhttp/plugins/backup-widget/overview-widget.php';

if (!function_exists('backup_widget_render_tile')) {
  function backup_widget_render_tile() {
    $css = "<style>"
      . ".bw { font-size:11.5px; line-height:1.45; }"
      . ".bw svg { display:inline-block; vertical-align:-2px; flex:none; }"
      . ".bw-head { display:flex; align-items:center; gap:12px; }"
      . ".bw-gauge { text-align:center; flex:none; }"
      . ".bw-gauge-l { font-size:8.5px; opacity:.55; margin-top:2px; letter-spacing:.02em; }"
      . ".bw-headtxt { min-width:0; }"
      . ".bw-status { font-size:12.5px; font-weight:600; margin-bottom:2px; }"
      . ".bw-sub { font-size:10.5px; opacity:.65; }"
      . ".bw-break { margin-top:2px; opacity:.9; }"
      . ".bw-act { margin-top:9px; padding-top:8px; border-top:1px solid #dcdcdc; }"
      . ".bw-act-l { font-size:11px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }"
      . ".bw-file { font-size:10px; opacity:.6; white-space:nowrap; overflow:hidden;"
      . " text-overflow:ellipsis; margin-top:5px; }"
      . ".bw-tool { opacity:.5; }"
      . ".bw-rev { opacity:.55; }"
      . ".bw-bar { position:relative; display:flex; align-items:center; height:17px;"
      . " border-radius:4px; background:#e8edf3; overflow:hidden; margin:9px 0 7px; }"
      /* Darker fill: at #2563eb against a light track the boundary was soft and
         the percentage did not read at a glance. */
      . ".bw-bar-f { height:100%; background:#1447c4; transition:width .9s linear;"
      . " display:flex; align-items:center; justify-content:flex-end; }"
      . ".bw-pct-in { font-size:9px; font-weight:700; color:#fff; padding-right:6px;"
      . " font-variant-numeric:tabular-nums; }"
      . ".bw-pct-out { font-size:10px; font-weight:700; color:#334155; padding-left:5px;"
      . " font-variant-numeric:tabular-nums; }"
      /* Three equal cells, vertically centred: the 1.35fr first column left the
         row looking lopsided against the bar above it. */
      . ".bw-act-s { display:grid; grid-template-columns:repeat(3,1fr); align-items:center;"
      . " min-height:15px; font-size:10px; opacity:.75; font-variant-numeric:tabular-nums; }"
      . ".bw-act-s span:nth-child(2) { text-align:center; }"
      . ".bw-act-s span:nth-child(3) { text-align:right; }"
      . ".bw-idle { margin-top:9px; padding-top:8px; border-top:1px solid #dcdcdc; font-size:11px; opacity:.6; }"
      . ".bw-grid { margin-top:9px; padding-top:7px; border-top:1px solid #dcdcdc; }"
      /* Fixed columns, and roomier rows - 20px was cramped. */
      . ".bw-gr { display:grid; grid-template-columns:1fr 30px 30px 30px 30px; align-items:center;"
      . " gap:3px; min-height:33px; }"
      . ".bw-gh { min-height:24px; padding-bottom:2px; }"
      . ".bw-row { cursor:pointer; border-radius:4px; }"
      . ".bw-row:hover { background:rgba(20,71,196,.07); }"
      . ".bw-mk { text-align:center; display:flex; flex-direction:column; align-items:center; gap:1px; }"
      . ".bw-cl { font-size:8px; opacity:.5; letter-spacing:.01em; }"
      . ".bw-spk { text-align:right; line-height:1; }"
      . ".bw-spk-h { font-size:8px; opacity:.5; text-align:right; }"
      . ".bw-spk-none { font-size:10px; opacity:.35; letter-spacing:1px; }"
      . ".bw-ds { display:flex; align-items:center; gap:6px; min-width:0; }"
      . ".bw-dsn { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }"
      . ".bw-det { display:none; padding:2px 0 7px 19px; }"
      /* Cloud and its state on ONE line: the previous two-block layout made you
         cross between columns and count positions to pair them up. */
      . ".bw-detr { display:grid; grid-template-columns:1fr auto; align-items:center;"
      . " gap:10px; font-size:10px; opacity:.85; line-height:1.9; }"
      . ".bw-detc { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }"
      . ".bw-dets { white-space:nowrap; display:flex; align-items:center; gap:5px; }"
      . ".bw-detp { border-top:1px solid #edf0f4; margin-top:4px; padding-top:4px; }"
      /* File count and size are reference, not something you read every visit. */
      . ".bw-detp .bw-detc, .bw-detp .bw-dets { opacity:.45; }"
      . ".bw-hist { display:grid; grid-template-columns:1fr auto; align-items:center;"
      . " gap:10px; font-size:10px; line-height:2; }"
      . ".bw-histl { opacity:.6; }"
      . ".bw-foot { margin-top:8px; font-size:9.5px; opacity:.5;"
      . " display:flex; justify-content:space-between; gap:8px; }"
      . ".bw-open { opacity:.85; text-decoration:none; white-space:nowrap; }"
      . ".bw-open:hover { text-decoration:underline; }"
      . "</style>";

    /* No "and-and", no angle brackets: see the header comment. jQuery is already
       loaded by the dashboard. The 30s tick parses the response as an inert
       document and moves the nodes in, rather than assigning markup to an HTML
       sink. */
    $poll = "<script>"
      /* Global, and outside the once-guard: the row markup references it via an
         onclick attribute, and the guard below returns early on any re-entry.
         Which rows are open is remembered OUTSIDE the DOM, because the 30s tick
         replaces every node - the expanded state used to live only in the nodes
         being thrown away, so a row you opened collapsed itself seconds later.
         localStorage so it also survives a dashboard reload. */
      . "window.bwOpen = window.bwOpen || {};"
      . "try { window.bwOpen = JSON.parse(localStorage.getItem('bwOpen')) || {}; } catch (e) { window.bwOpen = {}; }"
      . "window.bwSave = function(){"
      . "  try { localStorage.setItem('bwOpen', JSON.stringify(window.bwOpen)); } catch (e) { }"
      . "};"
      . "window.bwRestore = function(){"
      . "  var k;"
      . "  for (k in window.bwOpen) {"
      . "    if (window.bwOpen[k]) {"
      . "      var e = document.getElementById(k);"
      . "      if (e) { e.style.display = 'block'; }"
      . "    }"
      . "  }"
      . "};"
      . "window.bwToggle = function(id){"
      . "  var e = document.getElementById(id);"
      . "  if (!e) { return; }"
      . "  if (e.style.display === 'block') {"
      . "    e.style.display = 'none';"
      . "    window.bwOpen[id] = 0;"
      . "    window.bwSave();"
      . "    return;"
      . "  }"
      . "  e.style.display = 'block';"
      . "  window.bwOpen[id] = 1;"
      . "  window.bwSave();"
      . "};"
      . "(function(){"
      . "if (window.bwPoll) { return; }"
      . "function bwSet(id, v){"
      . "  if (v === undefined) { return; }"
      . "  if (v === null) { return; }"
      . "  var e = document.getElementById(id);"
      . "  if (!e) { return; }"
      . "  if (e.textContent !== String(v)) { e.textContent = v; }"
      . "}"
      . "function bwLive(){"
      . "  if (!document.getElementById('bw-body')) { return; }"
      . "  jQuery.getJSON('/plugins/backup-widget/overview-live.php', function(d){"
      . "    if (!d) { return; }"
      . "    if (!d.running) { return; }"
      . "    var b = document.getElementById('bw-bar');"
      . "    if (b) { b.style.width = (d.pct || 0) + '%'; }"
      /* No comparison operators here on purpose: the endpoint sends d.inside,
         because "p >= 14" would emit an angle bracket into a fragment that has to
         parse as XML. */
      . "    var p = Math.round(d.pct || 0);"
      . "    if (d.inside) { bwSet('bw-pct', p + '%'); bwSet('bw-pct-out', ''); }"
      . "    if (!d.inside) { bwSet('bw-pct', ''); bwSet('bw-pct-out', p + '%'); }"
      . "    bwSet('bw-bytes', d.bytes);"
      . "    bwSet('bw-rate', d.rate);"
      . "    bwSet('bw-eta', d.eta || '?');"
      . "    bwSet('bw-name', d.name);"
      . "    bwSet('bw-file', d.file);"
      . "  });"
      . "}"
      . "function bwFull(){"
      . "  var host = document.getElementById('bw-body');"
      . "  if (!host) { return; }"
      . "  jQuery.get('/plugins/backup-widget/widget-poll.php', function(h){"
      . "    var doc = new DOMParser().parseFromString(h, 'text/html');"
      . "    var next = doc.querySelector('.bw');"
      . "    if (!next) { return; }"
      . "    host.replaceChildren(document.importNode(next, true));"
      . "    window.bwRestore();"
      . "  });"
      . "}"
      . "window.bwRestore();"
      . "window.bwPoll = setInterval(bwLive, 1000);"
      . "window.bwPollFull = setInterval(bwFull, 30000);"
      . "})();"
      . "</script>";

    return "<tbody title='Backup coverage across Google Drive, Dropbox and mail.ru'>"
      /* "Backup Health", not "Backup": this is a monitoring dashboard, not the
         backup engine, and the generic name invited that confusion. */
      . "<tr><td><i class='fa fa-shield' style='margin-right:6px'></i>Backup Health "
      . "<span id='bw-state'>" . bo_widget_header() . "</span></td></tr>"
      . "<tr><td>" . $css . "<div id='bw-body'>" . bo_render_widget() . "</div>" . $poll . "</td></tr>"
      . "</tbody>";
  }
}

$backup_widget_plugin = 'backup-widget';
$mytiles[$backup_widget_plugin]['column2'] = backup_widget_render_tile();
?>
