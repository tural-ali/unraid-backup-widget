<div id="bo-panel"><?= bo_render() ?></div>

<script>
/* Expanded rows are remembered outside the DOM and re-applied after each rebuild.
   The 30s tick replaces every node, so state held only in those nodes disappears
   and rows collapse on their own - the bug that hit the tile. localStorage so it
   also survives navigating away and back. */
window.boOpen = {};
try { window.boOpen = JSON.parse(localStorage.getItem('boOpen')) || {}; } catch (e) { window.boOpen = {}; }

function boSaveOpen() {
  try { localStorage.setItem('boOpen', JSON.stringify(window.boOpen)); } catch (e) {}
}
function boRestoreOpen() {
  for (var k in window.boOpen) {
    if (window.boOpen[k]) {
      var e = document.getElementById(k);
      if (e) { e.style.display = 'block'; }
    }
  }
}
function boToggle(id) {
  var e = document.getElementById(id);
  if (!e) { return; }
  if (e.style.display === 'block') {
    e.style.display = 'none';
    window.boOpen[id] = 0;
  } else {
    e.style.display = 'block';
    window.boOpen[id] = 1;
  }
  boSaveOpen();
}

var boCount = 30, boBusy = false;

function boSet(id, val) {
  var e = document.getElementById(id);
  if (e && val !== undefined && val !== null && e.textContent !== String(val)) {
    e.textContent = val;
  }
}

function boLive() {
  fetch('/plugins/backup-widget/overview-live.php', {cache: 'no-store'})
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d || !d.running) { return; }
      var bar = document.getElementById('bo-bar');
      if (bar) { bar.style.width = (d.pct || 0) + '%'; }
      boSet('bo-pct', Math.round(d.pct || 0) + '%');
      boSet('bo-bytes', d.bytes || '');
      boSet('bo-rate', d.rate || '');
      boSet('bo-eta', d.eta || '?');
      boSet('bo-act-name', d.name || '');
      boSet('bo-file', d.file || '');
    })
    .catch(function () { /* a dropped tick is not worth surfacing; the next is 1s away */ });
}

function boRefresh() {
  if (boBusy) { return; }
  boBusy = true;
  fetch('/plugins/backup-widget/overview-poll.php', {cache: 'no-store'})
    .then(function (r) { return r.text(); })
    .then(function (html) {
      /* Parsed as an inert document and moved in, rather than assigned to an HTML
         sink. */
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var next = doc.querySelector('.bo-wrap');
      var host = document.getElementById('bo-panel');
      if (next && host) {
        host.replaceChildren(document.importNode(next, true));
        boRestoreOpen();
      }
      boCount = 30;
    })
    .catch(function () {})
    .then(function () { boBusy = false; });
}

boRestoreOpen();
setInterval(boLive, 1000);
setInterval(function () {
  boCount--;
  var c = document.getElementById('bo-count');
  if (c) { c.textContent = boCount > 0 ? boCount : 0; }
  if (boCount <= 0) { boRefresh(); }
}, 1000);
</script>
